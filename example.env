# Postgres: either DATABASE_URL …
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/wiki_references
# … or the individual parts
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASS=your_db_password
REVISION_BUNDLES_DIR=/path/to/revision/bundles
# Parquet tier (revisions, citation_history, … laid out <dataset>/domain=/page_bucket=/)
PARQUET_DIR=./parquet

# ── Stage 0: wcd stage0-load ──
# DuckDB memory limit for each of stage0-load's DuckDB connections (override with
# --memory-limit). Unset, DuckDB takes 80 % of RAM, too much next to Postgres on the
# same host; RSS runs ~5-7 GB above the limit (Python, Arrow).
# STAGE0_MEMORY_LIMIT=24GB

# ── Stage 1: wcd extract-all / wcd extract (CPU-bound extract & stage to Parquet) ──
# Directory for staged Parquet files (written by extract, deduped by dedup, loaded by load).
# The per-revision datasets go to PARQUET_DIR instead; --domain is given on the command line.
STAGING_DIR=./staging
# Revisions per batch processed by each extract worker, and the byte cap on a batch's
# revision texts (a batch flushes at whichever comes first; long articles need the cap)
BATCH_SIZE=1000
BATCH_BYTES=33554432
# Seconds between status updates from extract-all
METRICS_INTERVAL=10

# ── Stage 3: wcd dedup (consolidate & deduplicate staged files via DuckDB) ──
# DuckDB memory limit used by dedup_parquet.py (override with --memory-limit)
DEDUP_MEMORY_LIMIT=8GB
# DuckDB temp/spill directory (optional; override with --temp-dir)
# DEDUP_TEMP_DIR=./staging/tmp
# DuckDB execution threads (optional; override with --threads)
# DEDUP_THREADS=8
# Preserve insertion order during DuckDB execution (set false for lower memory)
DEDUP_PRESERVE_INSERTION_ORDER=false
# Staged rows per key partition for the large tables (override with --rows-per-partition):
# each partition is one GROUP BY, so memory follows this, not the table size (~6 GB at 20M
# rows with a 4 GB DuckDB limit, on enwiki)
# DEDUP_ROWS_PER_PARTITION=20000000
# Max spill size in temp directory (optional; override with --max-temp-dir-size)
# DEDUP_MAX_TEMP_DIRECTORY_SIZE=2TB

# ── Stage 3: wcd load (DB-bound bulk insert from deduped Parquet files) ──
# Template parameters go to the Parquet tier (template_params, template_param_index; needs
# PARQUET_DIR or --parquet-dir). DuckDB memory limit and rows per join partition for that
# step, and the citation count from which a value's template-report total is precomputed:
# LOAD_MEMORY_LIMIT=16GB
# LOAD_ROWS_PER_PARTITION=20000000
# TEMPLATE_COUNT_MIN=1000
# Connections loading web_resources, normalized_citations, citation_instances and ncwr
# (COPY + INSERT … SELECT, one Parquet row group per unit; override with --jobs). 16 on enwiki.
# LOAD_JOBS=8
# Drop citation_instances' / ncwr's foreign keys while loading them into empty tables, then add
# and validate them (default on; 0 checks every row instead, which stalls at enwiki scale)
# LOAD_DEFER_FKS=1
# Keep the key-sorted copies under $STAGING_DIR/.load-sort after a successful load (they are
# reused when a load is repeated; a failed load always keeps them)
# LOAD_KEEP_SORTED=0
# Rows per INSERT batch for the small tables (containers, domains, wiki_templates)
LOAD_BATCH_SIZE=5000

# ── Stages 4–8 ──
# parts: worker processes (--jobs) and normalized_citations ids per unit
# PARTS_JOBS=8
# PARTS_UNIT_IDS=1000000
# DuckDB, per connection (so per worker in match / revision-stats): memory limit, threads, spill
# directory. Unset: 80 % of RAM and every core per connection, which overruns a build.
# DUCKDB_MEMORY_LIMIT=16GB
# DUCKDB_THREADS=
# DUCKDB_TEMP_DIRECTORY=
# denorm-export: Postgres work_mem for its parallel COPY, longest CSV row, repartition groups
# DENORM_WORK_MEM=256MB
# DENORM_MAX_LINE_SIZE=67108864
# DENORM_GROUPS=16
# match: page slices per bucket (memory follows the slice)
# MATCH_PAGE_SLICES=8

# ── apps/api (wcd-api): the /api/v2 service ──
# Default domain for the /api/v1 alias paths
API_DEFAULT_DOMAIN=en.wikipedia.org
# Comma-separated CORS origins (default: *)
API_CORS_ORIGINS=*
# Postgres connections kept by the service
API_POOL_SIZE=5

# ── Wikipedia API requests (title URL -> curid resolution in /api/v2/article, legacy explorer) ──
# Primary product token for MediaWiki API User-Agent
WIKIPEDIA_API_USER_AGENT=WikiReferencesDB/1.0
# Contact email appended in parentheses to the User-Agent
WIKIPEDIA_API_CONTACT_EMAIL=your-email@example.com
# Optional secondary token appended to the User-Agent
WIKIPEDIA_API_SECONDARY_USER_AGENT=
