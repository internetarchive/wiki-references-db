# Environment of the wcd-api service (deploy/wcd-api.service). Copy to serve.env (mode 600),
# fill in, and keep it out of git. Settings are described in apps/api/README.md.

# the read-only role (deploy/create_api_role.sql)
DATABASE_URL=postgresql://wcd_api:CHANGE_ME@127.0.0.1:5432/wiki_references
PARQUET_DIR=/home/jh/wcd-data/parquet

API_DEFAULT_DOMAIN=en.wikipedia.org
# bare global source ids belong to this run
API_BASE_RUN_ID=enwiki-20261001
# Postgres connections per worker process
API_POOL_SIZE=5
# per-request DuckDB limits
API_DUCKDB_MEMORY_LIMIT=1GB
API_DUCKDB_THREADS=2
# v1 template id -> name table exported from the v1 database (docs/runbook.md, "Cutting over")
# API_LEGACY_TEMPLATE_IDS=/home/jh/wcd-serve/legacy_template_ids.tsv

# MediaWiki API User-Agent for /article?url=<title URL> lookups
WIKIPEDIA_API_USER_AGENT=WikipediaCitationsDatabase/2.0
WIKIPEDIA_API_CONTACT_EMAIL=
